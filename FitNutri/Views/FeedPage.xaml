<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FitNutri.Views"
             x:Class="FitNutri.Views.FeedPage"
             BackgroundColor="#F5F5F5"
             Title="Comunidade"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid RowDefinitions="Auto, *">
            
            <Border Grid.Row="0" BackgroundColor="White" Padding="15, 10" StrokeThickness="0">
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 20" HeightRequest="40" WidthRequest="40" StrokeThickness="0">
                        <Image Source="profile_icon.png" Aspect="AspectFill" />
                    </Border>
                    <Label Text="O que você está treinando hoje?" VerticalOptions="Center" TextColor="#BDBDBD" FontSize="14" />
                    <Button Text="Publicar" BackgroundColor="#272B3B" TextColor="White" CornerRadius="20" HeightRequest="35" WidthRequest="90" FontSize="12" HorizontalOptions="End" />
                </HorizontalStackLayout>
            </Border>

            <CollectionView Grid.Row="1" ItemsSource="{Binding MeusPosts}" Margin="0,5,0,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White" Padding="0" Margin="10,5" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">

                                <Grid ColumnDefinitions="Auto, *, Auto" Padding="15,10" ColumnSpacing="10">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 18" HeightRequest="36" WidthRequest="36" StrokeThickness="0">
                                        <Image Source="profile_icon.png" Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding NomeUsuario}" FontAttributes="Bold" TextColor="#212121" FontSize="14" />
                                        <Label Text="{Binding Tempo}" TextColor="#757575" FontSize="11" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="..." TextColor="#757575" FontSize="20" HorizontalOptions="End" />
                                </Grid>

                                <Label Text="{Binding Conteudo}" Padding="15,0" TextColor="#424242" FontSize="14" />

                                <Image Source="{Binding ImagemPost}" 
                                       Aspect="AspectFill" 
                                       HeightRequest="350" 
                                       WidthRequest="350"
                                       HorizontalOptions="Center"
                                       Margin="0,10,0,0" />

                                <BoxView HeightRequest="1" BackgroundColor="#EEEEEE" Margin="15,0" />

                                <Grid ColumnDefinitions="*, *, *" Padding="10,5">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="5" HorizontalOptions="Center">
                                        <Image Source="like_icon.png" HeightRequest="18" />
                                        <Label Text="Curtir" TextColor="#757575" FontSize="12" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="Center">
                                        <Image Source="comment_icon.png" HeightRequest="18" />
                                        <Label Text="Comentar" TextColor="#757575" FontSize="12" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="2" Spacing="5" HorizontalOptions="Center">
                                        <Image Source="share_icon.png" HeightRequest="18" />
                                        <Label Text="Compartilhar" TextColor="#757575" FontSize="12" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
                <CollectionView.Footer>
                    <BoxView HeightRequest="100" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </Grid>

        <local:FloatingNavBar VerticalOptions="End" />
    </Grid>
</ContentPage>
