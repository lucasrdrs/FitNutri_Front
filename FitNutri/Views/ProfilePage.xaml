<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FitNutri.Views"
             x:Class="FitNutri.Views.ProfilePage"
             BackgroundColor="#F5F5F5"
             Title="Meu Perfil"
             Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="20">
                
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,20,0,10">
                    <Border Stroke="{StaticResource Primary}" StrokeThickness="3" HeightRequest="120" WidthRequest="120" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="60" />
                        </Border.StrokeShape>
                        <Image Source="profile_icon.png" Aspect="AspectFill" />
                    </Border>
                    <Label Text="João Silva" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Secondary}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                    
                    <Border Grid.Column="0" Padding="10" BackgroundColor="White" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStatCardTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="Nível" FontSize="12" TextColor="{StaticResource Gray}" HorizontalOptions="Center" />
                            <Label Text="15" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    
                    <Border Grid.Column="1" Padding="10" BackgroundColor="White" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStatCardTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="Ranking" FontSize="12" TextColor="{StaticResource Gray}" HorizontalOptions="Center" />
                            <Label Text="#128" FontSize="18" FontAttributes="Bold" TextColor="#FFB300" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    
                    <Border Grid.Column="2" Padding="10" BackgroundColor="White" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStatCardTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="Pontos" FontSize="12" TextColor="{StaticResource Gray}" HorizontalOptions="Center" />
                            <Label Text="4.250" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                
                <Label Text="Configurações" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Secondary}" Margin="0,10,0,0" />

                <Border BackgroundColor="White" Padding="0" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="15" ColumnSpacing="15">
                            <Image Grid.Column="0" Source="edit_icon.png" HeightRequest="20" />
                            <Label Grid.Column="1" Text="Editar Perfil" VerticalOptions="Center" TextColor="{StaticResource Secondary}" />
                            <Label Grid.Column="2" Text=">" TextColor="{StaticResource Gray}" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Surface}" Margin="15,0" />
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="15" ColumnSpacing="15">
                            <Image Grid.Column="0" Source="settings_icon.png" HeightRequest="20" />
                            <Label Grid.Column="1" Text="Configurações da Conta" VerticalOptions="Center" TextColor="{StaticResource Secondary}" />
                            <Label Grid.Column="2" Text=">" TextColor="{StaticResource Gray}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="SAIR" BackgroundColor="Transparent" 
                        TextColor="#D32F2F" 
                        BorderColor="#D32F2F" 
                        BorderWidth="1" 
                        CornerRadius="10"
                        HeightRequest="45" 
                        Margin="0,10,0,20"
                        Clicked="OnLogoutClicked"
                        />

                <BoxView HeightRequest="100" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <local:FloatingNavBar VerticalOptions="End" />
    </Grid>
</ContentPage>
